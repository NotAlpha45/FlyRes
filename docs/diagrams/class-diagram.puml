@startuml class-diagram
' FlyRes class diagram. Update it whenever a class or public control method is added.
skinparam classAttributeIconSize 0
hide empty members

package "com.flyres" {
  class FlyResBackend <<facade>> {
    + FlyResBackend(database : DatabaseManager)
    + {static} create() : FlyResBackend
    + close() : void
  }
}

package "com.flyres.data" {
  class DatabaseManager <<singleton>> {
    - {static} instance : DatabaseManager
    - connection : Connection
    + {static} getInstance() : DatabaseManager
    + {static} forTesting() : DatabaseManager
    + {static} forTestingWithSeedData() : DatabaseManager
    ~ {static} openFile(file : Path) : DatabaseManager
    + getConnection() : Connection
    + close() : void
  }

  class TransactionRunner {
    + TransactionRunner(database : DatabaseManager)
    + inTransaction(work : Supplier<T>) : T
    + inTransaction(work : Runnable) : void
  }
}

package "com.flyres.common.exception" {
  class DataAccessException
  RuntimeException <|-- DataAccessException
}

package "com.flyres.ui" {
  class FlyResApp
  class Launcher
}

package "com.flyres.ui.navigation" {
  class SceneRouter {
    + SceneRouter(stage : Stage)
    + goTo(view : ViewId) : void
  }
  enum ViewId {
    HOME
  }
}

FlyResBackend --> DatabaseManager
TransactionRunner --> DatabaseManager
TransactionRunner ..> DataAccessException : throws
Launcher ..> FlyResApp : launches
FlyResApp --> FlyResBackend
FlyResApp ..> SceneRouter
SceneRouter ..> ViewId
@enduml
