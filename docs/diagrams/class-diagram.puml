@startuml class-diagram
' FlyRes class diagram. Update it whenever a class or public control method is added.
skinparam classAttributeIconSize 0
hide empty members

package "com.flyres" {
  class FlyResBackend <<facade>> {
    + FlyResBackend(database : DatabaseManager)
    + FlyResBackend(database : DatabaseManager, clock : Clock)
    + {static} create() : FlyResBackend
    + authentication() : AuthenticationController
    + flightSearch() : FlightSearchController
    + payments() : PaymentController
    + close() : void
  }
}

package "com.flyres.control" {
  class AuthenticationController <<control>> {
    + {static} LOGIN_FAILED : String
    + AuthenticationController(users : UserRepository, hasher : PasswordHasher, clock : Clock)
    + login(email : String, password : String) : User
    + registerCustomer(request : RegistrationRequest) : Customer
  }
  class RegistrationRequest <<record>> {
    firstName : String
    lastName : String
    email : String
    phone : String
    password : String
    confirmPassword : String
  }
  class FlightSearchController <<control>> {
    + {static} FLIGHT_UNAVAILABLE : String
    + FlightSearchController(flights : FlightRepository, seats : SeatRepository, airports : AirportRepository, airlines : AirlineRepository, clock : Clock)
    + listAirports(actor : User) : List<Airport>
    + listAirlines(actor : User) : List<Airline>
    + searchFlights(actor : User, criteria : SearchCriteria) : List<FlightSummary>
    + getFlightDetails(actor : User, flightId : long) : FlightDetails
  }
  class Access <<utility>> {
    ~ {static} require(actor : User, action : String, allowed : Role...) : void
  }
  class PaymentController <<control>> {
    + {static} DECLINED : String
    + PaymentController(payments : PaymentRepository, clock : Clock)
    + processPayment(actor : User, details : PaymentDetails, amountCents : long) : Payment
    + processPayment(actor : User, method : PaymentMethod, amountCents : long) : Payment
    + recordPayment(reservationId : long, payment : Payment) : Payment
  }
  class BookingController <<control>> {
    + BookingController(reservations : ReservationRepository, seats : SeatRepository, flights : FlightRepository, payments : PaymentController, transactions : TransactionRunner, clock : Clock, random : Random)
    + {static} SEAT_NOT_ON_FLIGHT : String
    + book(actor : User, request : BookingRequest) : BookingConfirmation
  }
  class ConfirmationCodeGenerator <<utility>> {
    ~ ConfirmationCodeGenerator(random : Random)
    ~ next(reservations : ReservationRepository) : String
  }
}

package "com.flyres.control.strategy" {
  interface PaymentMethod <<strategy>> {
    + validate(clock : Clock) : ValidationErrors
    + authorize(amountCents : long) : boolean
    + last4() : String
    + holderName() : String
  }
  class CardPayment {
    + {static} CARDHOLDER_NAME : String
    + {static} CARD_NUMBER : String
    + {static} EXPIRY : String
    + {static} CVV : String
    + CardPayment(details : PaymentDetails)
    ~ {static} passesLuhn(number : String) : boolean
  }
}

package "com.flyres.domain.booking" {
  class Payment <<entity>> {
    - id : long
    - reservationId : long
    - cardholderName : String
    - cardLast4 : String
    - amountCents : long
    - paidAt : LocalDateTime
    - refundedAt : LocalDateTime
    + {static} initiate(cardholderName : String, cardLast4 : String, amountCents : long) : Payment
    + authorize() : void
    + complete(at : LocalDateTime) : void
    + fail() : void
    + refund(at : LocalDateTime) : void
  }
  enum PaymentStatus <<entity>> {
    INITIATED
    AUTHORIZED
    COMPLETED
    FAILED
    REFUNDED
  }
  class PaymentDetails <<record>> {
    cardholderName : String
    cardNumber : String
    expiry : YearMonth
    cvv : String
    + digits() : String
  }
  class Reservation <<entity>> {
    - id : long
    - confirmationCode : String
    - customerId : long
    - amountCents : long
    - status : ReservationStatus
    - createdAt : LocalDateTime
    - cancelledAt : LocalDateTime
    + {static} pending(customerId : long, seat : Seat, flight : Flight, amountCents : long) : Reservation
    + {static} restore(id : long, confirmationCode : String, customerId : long, seat : Seat, flight : Flight, amountCents : long, status : ReservationStatus, createdAt : LocalDateTime, cancelledAt : LocalDateTime) : Reservation
    + confirm(code : String, at : LocalDateTime) : void
    + cancel(at : LocalDateTime) : void
    + statusAt(clock : Clock) : ReservationStatus
  }
  enum ReservationStatus <<entity>> {
    PENDING
    CONFIRMED
    CANCELLED
    COMPLETED
  }
  class BookingRequest <<record>> {
    customerId : long
    flightId : long
    seatId : long
    expectedPriceCents : long
    payment : PaymentDetails
  }
  class BookingConfirmation <<record>> {
    reservation : Reservation
    payment : Payment
  }
}

package "com.flyres.domain.flight" {
  class Airport <<entity>> <<record>> {
    id : long
    code : String
    name : String
    city : String
    country : String
  }
  class Airline <<entity>> <<record>> {
    id : long
    code : String
    name : String
  }
  class Aircraft <<entity>> <<record>> {
    id : long
    registration : String
    model : String
    seatRows : int
    seatsPerRow : int
    + capacity() : int
  }
  class Route <<entity>> <<record>> {
    id : long
  }
  class Seat <<entity>> <<record>> {
    id : long
    flightId : long
    label : String
    + {static} MAP_ORDER : Comparator<Seat>
    + row() : int
    + letter() : char
    + column() : int
  }
  class SeatAvailability <<record>> {
    taken : boolean
  }
  class FlightDetails <<record>> {
    seatRows : int
    seatsPerRow : int
    + {static} of(flight : Flight, seats : List<SeatAvailability>) : FlightDetails
    + availableCount() : int
    + isSoldOut() : boolean
  }
  class Flight <<entity>> {
    - id : long
    - flightNumber : String
    - departureTime : LocalDateTime
    - arrivalTime : LocalDateTime
    - priceCents : long
    + isDeparted(clock : Clock) : boolean
    + duration() : Duration
    + airline() : Airline
  }
  enum FlightStatus <<entity>> {
    SCHEDULED
    ARCHIVED
  }
  class SearchCriteria <<record>> {
    originCode : String
    destinationCode : String
    date : LocalDate
    airlineCode : String
  }
  class FlightSummary <<record>> {
    availableSeats : int
  }
}

package "com.flyres.domain.user" {
  abstract class User <<entity>> {
    - id : long
    - email : String
    - firstName : String
    - lastName : String
    - phone : String
    - createdAt : LocalDateTime
    + {abstract} getRole() : Role
    + getFullName() : String
    + hasRole(role : Role) : boolean
  }
  class Customer <<entity>>
  class FlightAgent <<entity>>
  class Administrator <<entity>>
  enum Role <<entity>> {
    CUSTOMER
    AGENT
    ADMIN
    + displayName() : String
  }
  class UserFactory <<factory>> {
    + {static} create(role : Role, id : long, email : String, firstName : String, lastName : String, phone : String, createdAt : LocalDateTime) : User
  }
}

package "com.flyres.repository" {
  interface UserRepository {
    + findById(id : long) : Optional<User>
    + findCredentialsByEmail(email : String) : Optional<UserCredentials>
    + existsByEmail(email : String) : boolean
    + insert(user : NewUser) : User
  }
  interface AirportRepository {
    + findAll() : List<Airport>
    + findByCode(code : String) : Optional<Airport>
  }
  interface AirlineRepository {
    + findAll() : List<Airline>
    + findByCode(code : String) : Optional<Airline>
  }
  interface PaymentRepository {
    + insert(reservationId : long, payment : Payment) : Payment
    + findByReservationId(reservationId : long) : Optional<Payment>
  }
  interface ReservationRepository {
    + insert(reservation : Reservation) : Reservation
    + findById(id : long) : Optional<Reservation>
    + existsByCode(confirmationCode : String) : boolean
    + hasConfirmedOnFlight(customerId : long, flightId : long) : boolean
  }
  interface SeatRepository {
    + findByFlight(flightId : long) : List<SeatAvailability>
    + findById(seatId : long) : Optional<Seat>
  }
  interface FlightRepository {
    + search(originCode : String, destinationCode : String, from : LocalDateTime, toExclusive : LocalDateTime, airlineCode : String) : List<FlightSummary>
    + findById(id : long) : Optional<Flight>
  }
  class UserCredentials <<record>> {
    user : User
    password : PasswordHash
  }
  class NewUser <<record>> {
    role : Role
    email : String
    firstName : String
    lastName : String
    phone : String
    password : PasswordHash
    createdAt : LocalDateTime
  }
}

package "com.flyres.data" {
  class DatabaseManager <<singleton>> {
    - {static} instance : DatabaseManager
    - connection : Connection
    + {static} getInstance() : DatabaseManager
    + {static} forTesting() : DatabaseManager
    + {static} forTestingWithSeedData() : DatabaseManager
    ~ {static} openFile(file : Path) : DatabaseManager
    + getConnection() : Connection
    + close() : void
  }

  class TransactionRunner {
    + TransactionRunner(database : DatabaseManager)
    + inTransaction(work : Supplier<T>) : T
    + inTransaction(work : Runnable) : void
  }
}

package "com.flyres.data.sqlite" {
  class SqliteUserRepository {
    + SqliteUserRepository(database : DatabaseManager)
  }
  class SqliteAirportRepository
  class SqliteAirlineRepository
  class SqliteFlightRepository
  class SqlitePaymentRepository
  class SqliteReservationRepository {
    + SqliteReservationRepository(database : DatabaseManager, flights : FlightRepository)
  }
  class SqliteSeatRepository
}

package "com.flyres.common.exception" {
  class DataAccessException
  class ValidationException {
    + getField() : String
    + getFieldErrors() : Map<String, String>
  }
  class NotFoundException
  class AccessDeniedException
  class BookingException
  RuntimeException <|-- DataAccessException
  RuntimeException <|-- ValidationException
  RuntimeException <|-- NotFoundException
  RuntimeException <|-- AccessDeniedException
  RuntimeException <|-- BookingException
}

package "com.flyres.common.security" {
  class PasswordHasher {
    + hash(password : String) : PasswordHash
    + verify(password : String, stored : PasswordHash) : boolean
  }
  class PasswordHash <<record>> {
    hash : String
    salt : String
  }
}

package "com.flyres.common.validation" {
  class Validators <<utility>> {
    + {static} isBlank(value : String) : boolean
    + {static} isEmail(value : String) : boolean
    + {static} isStrongPassword(value : String) : boolean
    + {static} isPhone(value : String) : boolean
    + {static} normalizeEmail(email : String) : String
    + {static} trimToNull(value : String) : String
  }
  class ValidationErrors {
    + add(field : String, message : String) : ValidationErrors
    + has(field : String) : boolean
    + throwIfAny() : void
  }
}

package "com.flyres.ui" {
  class FlyResApp
  class Launcher
  class AppSession {
    + login(user : User) : void
    + logout() : void
    + isLoggedIn() : boolean
    + currentUser() : Optional<User>
    + requireUser() : User
  }
}

package "com.flyres.ui.navigation" {
  class SceneRouter {
    + SceneRouter(stage : Stage, backend : FlyResBackend, session : AppSession)
    + goTo(view : ViewId) : C
    + startSession(user : User) : void
    + logout() : void
  }
  class ViewContext <<record>> {
    backend : FlyResBackend
    session : AppSession
    router : SceneRouter
  }
  enum ViewId {
    LOGIN
    REGISTER
    HOME
    FLIGHT_SEARCH
    FLIGHT_DETAILS
    BOOKING_PAYMENT
    BOOKING_CONFIRMATION
    COMPONENT_DEMO
    + title() : String
  }
}

package "com.flyres.ui.component" {
  class Toasts <<utility>> {
    + {static} install(root : StackPane) : void
    + {static} success(source : Node, message : String) : void
    + {static} error(source : Node, message : String) : void
  }
  class ErrorReporter <<utility>> {
    + {static} UNEXPECTED_ERROR : String
    + {static} install(stage : Stage) : void
    + {static} showStartupFailure(error : Throwable) : void
  }
  class ConfirmDialog <<utility>> {
    + {static} show(owner : Node, title : String, message : String, confirmLabel : String) : boolean
  }
  class FormValidator {
    + field(name : String, input : Control, errorLabel : Label) : FormValidator
    + showError(name : String, message : String) : void
    + clearErrors() : void
    + hasErrors() : boolean
    + focusFirstError() : void
  }
  class FlightTable {
    + setEmptyMessage(message : String) : void
    + addActionColumn(buttonText : String, action : Consumer<FlightSummary>, disabledReason : String) : void
  }
  class PaymentForm {
    + toDetails() : PaymentDetails
    + showErrors(fieldErrors : Map<String, String>) : void
    + clearErrors() : void
    + clearCvv() : void
    + setCardholderName(name : String) : void
  }
  class SeatMapView {
    + setSeats(seatRows : int, seatsPerRow : int, seats : List<SeatAvailability>) : void
    + selectedSeatProperty() : ReadOnlyObjectProperty<Seat>
    + getSelectedSeat() : Seat
    + clearSelection() : void
    + setHighlightedSeat(seat : Seat) : void
    + setReadOnly(readOnly : boolean) : void
  }
  class Formats <<utility>> {
    + {static} money(cents : long) : String
    + {static} date(date : LocalDate) : String
    + {static} dateTime(dateTime : LocalDateTime) : String
    + {static} arrivalTime(departure : LocalDateTime, arrival : LocalDateTime) : String
    + {static} duration(duration : Duration) : String
  }
}

package "com.flyres.ui.view.search" {
  class FlightSearchViewController <<boundary>> {
    + FlightSearchViewController(context : ViewContext)
