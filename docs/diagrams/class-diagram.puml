@startuml class-diagram
' FlyRes class diagram. Update it whenever a class or public control method is added.
skinparam classAttributeIconSize 0
hide empty members

package "com.flyres" {
  class FlyResBackend <<facade>> {
    + FlyResBackend(database : DatabaseManager)
    + {static} create() : FlyResBackend
    + close() : void
  }
}

package "com.flyres.data" {
  class DatabaseManager <<singleton>> {
    - {static} instance : DatabaseManager
    - connection : Connection
    + {static} getInstance() : DatabaseManager
    + {static} forTesting() : DatabaseManager
    + getConnection() : Connection
    + close() : void
  }
}

package "com.flyres.ui" {
  class FlyResApp
  class Launcher
}

package "com.flyres.ui.navigation" {
  class SceneRouter {
    + SceneRouter(stage : Stage)
    + goTo(view : ViewId) : void
  }
  enum ViewId {
    HOME
    COMPONENT_DEMO
    + title() : String
  }
}

package "com.flyres.ui.component" {
  class Toasts <<utility>> {
    + {static} install(root : StackPane) : void
    + {static} success(source : Node, message : String) : void
    + {static} error(source : Node, message : String) : void
  }
  class ConfirmDialog <<utility>> {
    + {static} show(owner : Node, title : String, message : String, confirmLabel : String) : boolean
  }
  class FormValidator {
    + field(name : String, input : Control, errorLabel : Label) : FormValidator
    + showError(name : String, message : String) : void
    + clearErrors() : void
    + hasErrors() : boolean
    + focusFirstError() : void
  }
}

package "com.flyres.ui.view.shell" {
  class AppShellViewController <<boundary>> {
    + setNavigation(views : List<ViewId>, onSelect : Consumer<ViewId>) : void
    + show(view : ViewId, page : Node) : void
  }
}

package "com.flyres.ui.view.demo" {
  class ComponentDemoViewController <<boundary>>
}

FlyResBackend --> DatabaseManager
Launcher ..> FlyResApp : launches
FlyResApp --> FlyResBackend
FlyResApp ..> SceneRouter
SceneRouter ..> ViewId
SceneRouter --> AppShellViewController
SceneRouter ..> Toasts : installs
AppShellViewController ..> ViewId
ComponentDemoViewController ..> Toasts
ComponentDemoViewController ..> ConfirmDialog
ComponentDemoViewController --> FormValidator
@enduml
