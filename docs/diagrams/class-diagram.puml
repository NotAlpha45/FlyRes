  }
  class BookingConfirmationViewController <<boundary>> {
    + BookingConfirmationViewController(context : ViewContext)
    + showReservation(reservation : Reservation, cardLast4 : String) : void
  }
}

package "com.flyres.ui.view.shell" {
  class AppShellViewController <<boundary>> {
