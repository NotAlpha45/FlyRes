<?xml version="1.0" encoding="UTF-8"?>

<?import com.flyres.ui.component.SeatMapView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Move an upcoming trip to another free seat on the same flight. -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.flyres.ui.view.trips.ChangeSeatViewController"
      styleClass="page">

    <HBox styleClass="button-row">
        <Button text="← Back to trip" onAction="#onBack" styleClass="flat"/>
    </HBox>

    <VBox styleClass="card">
        <HBox styleClass="card-header">
            <Label fx:id="flightLabel" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh seats" onAction="#onRefresh"/>
        </HBox>
        <Label fx:id="currentSeatLabel" styleClass="text-muted"/>
        <SeatMapView fx:id="seatMap"/>
        <HBox styleClass="button-row">
            <Label fx:id="selectionLabel" styleClass="selection-summary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="changeButton" text="Change seat" styleClass="accent" onAction="#onChangeSeat"
                    disable="true"/>
        </HBox>
    </VBox>
</VBox>
