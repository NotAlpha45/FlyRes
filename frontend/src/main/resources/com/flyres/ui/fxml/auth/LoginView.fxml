<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Full-window login screen: one centred card. -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.flyres.ui.view.auth.LoginViewController"
           styleClass="auth-screen">
    <VBox styleClass="card,auth-card" maxHeight="-Infinity">
        <Label text="FlyRes" styleClass="auth-brand"/>
        <VBox styleClass="auth-header">
            <Label text="Log in" styleClass="auth-title"/>
            <Label text="Use the email and password for your FlyRes account." wrapText="true"
                   styleClass="text-muted"/>
        </VBox>

        <VBox styleClass="form-field">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="name@example.com"/>
            <Label fx:id="emailError" styleClass="field-error" wrapText="true"/>
        </VBox>
        <VBox styleClass="form-field">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"/>
            <Label fx:id="passwordError" styleClass="field-error" wrapText="true"/>
        </VBox>

        <Button text="Log in" onAction="#onLogin" defaultButton="true" maxWidth="Infinity" styleClass="accent"/>

        <HBox styleClass="auth-footer">
            <Label text="New to FlyRes?" styleClass="text-muted"/>
            <Hyperlink text="Create an account" onAction="#onCreateAccount"/>
        </HBox>
    </VBox>
</StackPane>
